# AI 分析和问答至少需要配置一个模型服务。默认使用下列第一个已配置的服务。
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODEL=deepseek-v4.1-flash

# 代理配置（可选）。留空时，YouTube 会检测直连和服务端可发现的代理。
# YTDLP_PROXY=http://127.0.0.1:7892

# yt-dlp SSL 证书验证（默认开启，生产环境保持注释即可）
# 仅在国内网络劫持导致证书错误时临时设为 true
# YTDLP_NO_CHECK_CERTIFICATES=true

# 站内账号使用同源站点。使用不同的 Vite 地址时同步修改，例如 5174。
# SITE_ORIGIN=http://127.0.0.1:5173
# Compose 生产部署时必须设置实际 HTTPS 地址和两级 AI 日额度。
# SITE_ORIGIN=https://video.example.com
# AUTH_AI_ACCOUNT_DAILY=30
# AUTH_AI_SITE_DAILY=300
ALLOWED_ORIGINS=*
